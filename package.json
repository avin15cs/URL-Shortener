{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix frontend",
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "10.0.7"
  }
}
