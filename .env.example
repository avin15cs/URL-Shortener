AUTH_ISSUER=http://localhost:9000
AUTH_AUTHORIZATION_URI=http://localhost:9000/oauth2/authorize
AUTH_TOKEN_URI=http://localhost:9000/oauth2/token
AUTH_JWK_SET_URI=http://localhost:9000/oauth2/jwks
AUTH_USER_INFO_URI=http://localhost:9000/userinfo
AUTH_AUDIENCE=url-shortener-api
URL_SHORTENER_CLIENT_ID=url-shortener
# Configure the same strong value in the sibling auth-server repository.
URL_SHORTENER_CLIENT_SECRET=replace-with-a-strong-local-secret
URL_SHORTENER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/auth-server
FRONTEND_URL=http://localhost:5174
COOKIE_SECURE=false
